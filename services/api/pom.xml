<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.8</version>
    <relativePath/>
  </parent>

  <groupId>dev.chaya</groupId>
  <artifactId>chaya-api</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>chaya-api</name>
  <description>Chaya 02 backend API</description>

  <properties>
    <java.version>21</java.version>
    <!-- Patch releases ahead of Boot 4.0.8's managed versions, each in the same minor line Boot manages, for fixable
         HIGH/CRITICAL advisories that fail the image scan (.github/workflows/docker.yml). Drop each override once the Boot
         parent manages that version or newer.
         - tomcat-embed-core 11.0.24 -> 11.0.26: CVE-2026-65182, CVE-2026-65905, CVE-2026-68525 (CRITICAL, fixed in 11.0.25).
         - Jackson 3 (tools.jackson) 3.1.5 -> 3.1.7: jackson-core CVE-2026-89407, CVE-2026-89425; jackson-databind
           CVE-2026-68497, CVE-2026-91776, CVE-2026-91777 (HIGH, fixed in 3.1.7). Boot 4 puts Jackson 3 on the classpath
           even though the API's JSON stays on Jackson 2.
         - Jackson 2 (com.fasterxml) 2.21.5 -> 2.21.7: jackson-databind CVE-2026-68497 (HIGH, fixed in 2.21.6). Jackson 2
           serves the API's JSON (spring-boot-jackson2 below) and swagger-core uses it.
         (Boot 4.0.8 itself manages the pgjdbc and Netty fixes the 3.5.16 build had to override.) -->
    <tomcat.version>11.0.26</tomcat.version>
    <jackson-bom.version>3.1.7</jackson-bom.version>
    <jackson-2-bom.version>2.21.7</jackson-2-bom.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>2.29.52</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.tika</groupId>
      <artifactId>tika-core</artifactId>
      <!-- 3.2.2+: fixes the critical XXE advisory CVE-2025-66516 affecting tika-core 1.13-3.2.1. Only magic-byte
           detection is used here (no PDF/XML parsing), but the vulnerable range is not kept. -->
      <version>3.2.2</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <!-- Boot 4 defaults to Jackson 3. The API keeps Jackson 2 (spring.http.converters.preferred-json-mapper=jackson2 in
         application.yml) so the JSON wire format, the services' ObjectMapper use and the tests stay exactly as they were
         under Boot 3.5. Boot marks this module deprecated: moving to Jackson 3 is a separate, contract-checked change. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-jackson2</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- Boot 4: the auto-configured RestClient.Builder (HttpTextEmbeddingClient, the vision service) is its own module. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-restclient</artifactId>
    </dependency>
    <!-- Generates the OpenAPI document from the controllers; packages/contracts/openapi/v1.yaml is its committed output. -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
      <!-- 3.0.x is the line built against Boot 4.0 (3.1.x targets Boot 4.1). -->
      <version>3.1.1</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <!-- /actuator/prometheus (scrape-credential protected, see SecurityConfig and docs/monitoring.md) -->
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <!-- Boot 4: Flyway's auto-configuration (migrate on startup) is its own module; flyway-core alone no longer runs it. -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <!-- Boot 4 test starters are per technology (each brings spring-boot-starter-test): MockMvc and @WebMvcTest, and
         spring-security-test. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>build-info</goal>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
