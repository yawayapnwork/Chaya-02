{
 "name": "korno-climbing-rock-24",
 "description": "24 consecutive photographs (frames 25-48 of 98) of the Korno climbing rock (Czech Republic), taken for photogrammetry in one session on 2026-08-11 between 21:26 and 21:30. A real outdoor rock face: real camera input for SfM and Gaussian Splatting, NOT an indoor venue.",
 "source": "https://commons.wikimedia.org/wiki/Category:Photogrammetry_of_Korno_climbing_rock",
 "author": "Zbytovsky (Wikimedia Commons user), own work",
 "license": "CC0-1.0",
 "license_url": "https://creativecommons.org/publicdomain/zero/1.0/",
 "license_checked": "2026-10-24, Wikimedia Commons API extmetadata (LicenseShortName CC0, UsageTerms: Creative Commons Zero, Public Domain Dedication) for every file below",
 "camera_assumptions": "one camera for the whole set: EXIF of all 24 originals (checked 2026-10-24) reads DJI FC9670, focal length 4.85 mm (26 mm in 35 mm terms), 8000x4500 JPEG. No calibration is supplied: COLMAP self-calibrates one shared SIMPLE_RADIAL camera (ImageReader.single_camera), and SPLAT_RECONSTRUCTION undistorts to pinhole before training.",
 "derived": {
  "width": 1600,
  "height": 900,
  "resize": "cv2.INTER_AREA from the original",
  "encoding": "JPEG quality 95 (cv2.imwrite)",
  "note": "The originals are the reproducibility anchor (Commons SHA-1, verified on download). Derived frame hashes are recorded per run in dataset.json; another JPEG decoder or encoder build may produce different bytes from the same originals."
 },
