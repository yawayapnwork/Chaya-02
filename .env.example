# Copy to .env and fill in. Never commit .env. Values below are placeholders, not credentials.
# Docker Compose refuses to start if a required value is missing.

# --- PostgreSQL (pgvector) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=chaya
POSTGRES_USER=chaya
POSTGRES_PASSWORD=

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- MinIO (S3 API) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_RAW=chaya-raw
S3_BUCKET_DERIVED=chaya-derived
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Keycloak ---
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=

# --- Backend (services/api) ---
API_PORT=8080

# --- Frontend (apps/web, server-side) ---
CHAYA_API_BASE_URL=http://localhost:8080
