# Copy to .env and fill in. Never commit .env. Values below are placeholders, not credentials.
# Docker Compose refuses to start if a required value is missing.

# --- PostgreSQL (pgvector) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=chaya
# Bootstrap superuser: database init and backups only. Never used by the API.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# The API's role: owns the schema, not a superuser (infra/docker/postgres/initdb/10-app-role.sh).
POSTGRES_APP_USER=chaya
POSTGRES_APP_PASSWORD=

# --- Redis (not used by any service yet; kept password-protected and bound to localhost) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- MinIO (S3 API) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
# MinIO root: used only by the one-shot minio-init container to create buckets and accounts.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# The API's own MinIO account (raw + derived read/write/delete). Created by minio-init; must differ from root.
S3_ACCESS_KEY=
S3_SECRET_KEY=
# The reconstruction worker's account (raw read-only, derived read/write, no delete).
S3_WORKER_ACCESS_KEY=
S3_WORKER_SECRET_KEY=
# Read-only account used by scripts/backup.
S3_BACKUP_ACCESS_KEY=
S3_BACKUP_SECRET_KEY=
S3_BUCKET_RAW=chaya-raw
S3_BUCKET_DERIVED=chaya-derived
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- ClamAV (malware scanning of uploads) ---
# Uploads are never accepted unscanned: with CLAMAV_ENABLED=false every upload is quarantined.
CLAMAV_ENABLED=true
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --- Keycloak ---
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=
# Secret of the chaya-worker service account (imported into the realm, used by workers). Generate a long random value.
CHAYA_WORKER_CLIENT_SECRET=

# --- Backend (services/api) ---
API_PORT=8080
CHAYA_ALLOWED_ORIGINS=http://localhost:3000   # web origins allowed to call the API from a browser
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/chaya
KEYCLOAK_AUDIENCE=chaya-api
# KEYCLOAK_JWKS_URI=   # optional; defaults to <issuer>/protocol/openid-connect/certs
# Password Prometheus uses (HTTP Basic, user "prometheus") for /actuator/prometheus. Empty = endpoint closed.
METRICS_SCRAPE_PASSWORD=
# CHAYA_RATE_LIMIT_ENABLED=true        # per-minute budgets, see docs/security.md "Rate limits"
# LOGGING_STRUCTURED_FORMAT_CONSOLE=ecs # JSON logs for Loki (docs/monitoring.md)

# --- Reconstruction worker (services/reconstruction), when run outside Docker ---
CHAYA_API_URL=http://localhost:8080
CHAYA_TOKEN_URL=http://localhost:8081/realms/chaya/protocol/openid-connect/token
CHAYA_CLIENT_ID=chaya-worker
CHAYA_CLIENT_SECRET=                  # same value as CHAYA_WORKER_CLIENT_SECRET
# Model weights: pin Hugging Face revisions (commit SHAs). Only safetensors weights load unless explicitly allowed.
# GROUNDING_DINO_REVISION=
# SEMANTIC_SEGMENTATION_REVISION=
# MODEL_ALLOW_PICKLE_WEIGHTS=false
# WORKER_STAGES=                      # optional comma-separated subset of stages this worker executes
# FFMPEG_BIN= / COLMAP_BIN= / GLOMAP_BIN=   # optional explicit tool locations

# --- Vision service (services/vision): real-time CLIP text embeddings for semantic search ---
VISION_SERVICE_PORT=8090
VISION_SERVICE_URL=http://localhost:8090   # used by services/api's SearchProperties

# --- Frontend (apps/web, server-side) ---
CHAYA_API_BASE_URL=http://localhost:8080
# Browser-side settings (public by nature; no secrets here)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_OIDC_ISSUER=http://localhost:8081/realms/chaya
NEXT_PUBLIC_OIDC_CLIENT_ID=chaya-web

# --- Monitoring stack (infra/monitoring; docs/monitoring.md) ---
GRAFANA_ADMIN_PASSWORD=
GLITCHTIP_SECRET_KEY=                 # long random value
GLITCHTIP_DB_PASSWORD=

# --- Backups (scripts/backup; docs/backup-recovery.md) ---
BACKUP_DIR=./backups                  # outside the repo in production; *never* committed
BACKUP_KEEP_DAYS=14
