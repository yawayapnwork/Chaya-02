# Production environment for infra/deploy/docker-compose.yml. Copy to /srv/chaya/.env on the host (mode 600, owned by
# the deploy user). NEVER commit the filled-in file; it is the only place these secrets live on the host.
# Generate secrets with:  openssl rand -base64 36 | tr -d '/+=' | cut -c1-40
# Every value marked REQUIRED makes `docker compose` refuse to start when missing.

# --- Images ---------------------------------------------------------------------------------------------------------
CHAYA_REGISTRY=ghcr.io/<owner>          # REQUIRED; lowercase. CHAYA_VERSION is passed by deploy.sh, not set here.

# --- Public names (DNS A/AAAA records must point at this host before the first deploy: Caddy obtains certificates) --
CHAYA_APP_DOMAIN=app.example.org        # REQUIRED  web app
CHAYA_API_DOMAIN=api.example.org        # REQUIRED  API
CHAYA_AUTH_DOMAIN=auth.example.org      # REQUIRED  Keycloak
CHAYA_ACME_EMAIL=ops@example.org        # REQUIRED  Let's Encrypt account contact
KEYCLOAK_ADMIN_ALLOW=203.0.113.0/24     # CIDRs allowed to reach the Keycloak admin console (space-separated)

# --- PostgreSQL ------------------------------------------------------------------------------------------------------
POSTGRES_DB=chaya
POSTGRES_USER=postgres                  # bootstrap superuser: init and backups only
POSTGRES_PASSWORD=                      # REQUIRED secret
POSTGRES_APP_USER=chaya                 # the API's non-superuser role
POSTGRES_APP_PASSWORD=                  # REQUIRED secret
KEYCLOAK_DB_PASSWORD=                   # REQUIRED secret (Keycloak's own database)

# --- MinIO (root used only by minio-init) ----------------------------------------------------------------------------
MINIO_ROOT_USER=                        # REQUIRED
MINIO_ROOT_PASSWORD=                    # REQUIRED secret
S3_ACCESS_KEY=chaya-api                 # REQUIRED  API account
S3_SECRET_KEY=                          # REQUIRED secret
S3_WORKER_ACCESS_KEY=chaya-worker       # REQUIRED  worker account (raw read-only, derived read/write)
S3_WORKER_SECRET_KEY=                   # REQUIRED secret
S3_RECON_ACCESS_KEY=                    # needed for GPU workers: derived only, no raw bucket, no pii/ (e.g. chaya-recon)
S3_RECON_SECRET_KEY=                    # secret, when S3_RECON_ACCESS_KEY is set
S3_BACKUP_ACCESS_KEY=chaya-backup       # REQUIRED  read-only backup account
S3_BACKUP_SECRET_KEY=                   # REQUIRED secret
S3_BUCKET_RAW=chaya-raw
S3_BUCKET_DERIVED=chaya-derived
# MINIO_IMAGE=quay.io/minio/minio@sha256:...   # pin by digest in production
# MC_IMAGE=quay.io/minio/mc@sha256:...

# --- Keycloak --------------------------------------------------------------------------------------------------------
KEYCLOAK_ADMIN=                         # REQUIRED  temporary bootstrap admin; replace with a named admin after setup
KEYCLOAK_ADMIN_PASSWORD=                # REQUIRED secret
CHAYA_WORKER_CLIENT_SECRET=             # REQUIRED secret (imported into the realm; used by workers)

# --- Observability ---------------------------------------------------------------------------------------------------
METRICS_SCRAPE_PASSWORD=                # empty = /actuator/prometheus closed

# --- Backups (scripts/backup) ----------------------------------------------------------------------------------------
BACKUP_DIR=/srv/chaya-backups           # outside the deploy directory; encrypted storage; see docs/backup-recovery.md
BACKUP_KEEP_DAYS=14
